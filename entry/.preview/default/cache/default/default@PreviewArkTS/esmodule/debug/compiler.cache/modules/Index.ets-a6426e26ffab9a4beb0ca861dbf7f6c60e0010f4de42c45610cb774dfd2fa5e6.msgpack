import { Word } from 'common_har/src/main/ets/components/common/Word'
import { wordDictionary } from 'common_har/src/main/ets/components/common/word-dictionary'
import { saveWordList, getWordList } from 'common_har/src/main/ets/components/common/Sputils'

// èƒŒè¯µæ¨¡å¼æšä¸¾
enum ReciteMode {
  EN_TO_CN, // è‹±è¯‘æ±‰
  CN_TO_EN  // æ±‰è¯‘è‹±
}

@Entry
@Component
struct WordRecitePage {
  // åŸºç¡€çŠ¶æ€
  @State wordList: Word[] = []
  @State filteredWordList: Word[] = [] // æœç´¢/é”™è¯è¿‡æ»¤åçš„åˆ—è¡¨
  @State currentIndex: number = 0
  @State showAnswer: boolean = false
  @State currentMode: ReciteMode = ReciteMode.EN_TO_CN

  // æ–°å¢åŠŸèƒ½çŠ¶æ€
  @State searchText: string = ""
  @State isWrongBook: boolean = false // æ˜¯å¦å¼€å¯é”™è¯æœ¬æ¨¡å¼

  // é¡µé¢åˆå§‹åŒ–
  async aboutToAppear() {
    const localWords = await getWordList()
    if (localWords.length === 0) {
      // é¦–æ¬¡å¯åŠ¨ï¼šä»å•è¯åº“å¯¼å…¥æ•°æ®
      this.wordList = wordDictionary.map(item => new Word(item.english, item.chinese, item.isWrong || false))
      await saveWordList(this.wordList)
    } else {
      this.wordList = localWords
    }
    this.filteredWordList = [...this.wordList] // åˆå§‹åŒ–è¿‡æ»¤åˆ—è¡¨
  }

  // åˆ‡æ¢ä¸‹ä¸€ä¸ªå•è¯
  nextWord() {
    if (this.filteredWordList.length === 0) return
    this.currentIndex = (this.currentIndex + 1) % this.filteredWordList.length
    this.showAnswer = false
  }

  // åˆ‡æ¢èƒŒè¯µæ¨¡å¼
  switchMode() {
    this.currentMode = this.currentMode === ReciteMode.EN_TO_CN
      ? ReciteMode.CN_TO_EN
      : ReciteMode.EN_TO_CN
    this.showAnswer = false
  }

  // æœç´¢å•è¯ï¼šå®æ—¶è¿‡æ»¤
  onSearchChange(value: string) {
    this.searchText = value.trim()
    if (this.searchText === "") {
      // æœç´¢æ¡†ä¸ºç©ºï¼šæ˜¾ç¤ºå…¨éƒ¨/é”™è¯åˆ—è¡¨
      this.filteredWordList = this.isWrongBook
        ? [...this.wordList.filter(word => word.isWrong)]
        : [...this.wordList]
      return
    }
    // å…³é”®è¯åŒ¹é…ï¼šè‹±æ–‡æˆ–ä¸­æ–‡åŒ…å«è¾“å…¥å†…å®¹
    this.filteredWordList = this.wordList.filter(word => {
      const matchEng = word.english.toLowerCase().includes(this.searchText.toLowerCase())
      const matchChn = word.chinese.includes(this.searchText)
      // é”™è¯æœ¬æ¨¡å¼ä¸‹åªåŒ¹é…é”™è¯
      return this.isWrongBook
        ? (word.isWrong && (matchEng || matchChn))
        : (matchEng || matchChn)
    })
    this.currentIndex = 0
    this.showAnswer = false
  }

  // æ ‡è®°/å–æ¶ˆé”™è¯
  toggleWrongWord() {
    if (this.filteredWordList.length === 0) return
    const currentWord = this.filteredWordList[this.currentIndex]
    currentWord.isWrong = !currentWord.isWrong
    // æ›´æ–°åŸåˆ—è¡¨å¹¶ä¿å­˜
    const originIndex = this.wordList.findIndex(word => word.english === currentWord.english)
    if (originIndex !== -1) {
      this.wordList[originIndex] = currentWord
    }
    saveWordList(this.wordList)
    this.onSearchChange(this.searchText) // åˆ·æ–°è¿‡æ»¤åˆ—è¡¨
  }

  // åˆ‡æ¢é”™è¯æœ¬/å…¨éƒ¨å•è¯æ¨¡å¼
  toggleWrongBook() {
    this.isWrongBook = !this.isWrongBook
    this.searchText = ""
    this.onSearchChange("")
    this.currentIndex = 0
    this.showAnswer = false
  }

  // æ„å»ºUIç•Œé¢
  build() {
    Column() {
      // é¡¶éƒ¨æ ï¼šæ ‡é¢˜+æ¨¡å¼åˆ‡æ¢+é”™è¯æœ¬åˆ‡æ¢
      Row({ space: 10 }) {
        Text("å•è¯èƒŒè¯µå°åŠ©æ‰‹")
          .fontSize(24)
          .fontWeight(FontWeight.Bold)
          .fontColor('#3366CC')
        Blank()
        Button(this.currentMode === ReciteMode.EN_TO_CN ? "è‹±è¯‘æ±‰" : "æ±‰è¯‘è‹±")
          .fontSize(12)
          .backgroundColor('#4CAF50')
          .fontColor(Color.White)
          .borderRadius(20)
          .width(70)
          .onClick(() => this.switchMode())
        Button(this.isWrongBook ? "å…¨éƒ¨å•è¯" : "é”™è¯æœ¬")
          .fontSize(12)
          .backgroundColor(this.isWrongBook ? '#FF5722' : '#607D8B')
          .fontColor(Color.White)
          .borderRadius(20)
          .width(70)
          .onClick(() => this.toggleWrongBook())
      }
      .width('90%')
      .margin({ top: 30, bottom: 15 })

      // æœç´¢æ¡†
      Search({ placeholder: "è¾“å…¥è‹±æ–‡/ä¸­æ–‡æœç´¢", value: this.searchText })
        .width('90%')
        .height(40)
        .backgroundColor(Color.White)
        .borderRadius(8)
        .onChange((value) => this.onSearchChange(value))
        .margin({ bottom: 15 })

      // å•è¯å¡ç‰‡å±•ç¤ºåŒº
      if (this.filteredWordList.length > 0) {
        Stack() {
          Column() {
            Text(this.currentMode === ReciteMode.EN_TO_CN
              ? this.filteredWordList[this.currentIndex].english
              : this.filteredWordList[this.currentIndex].chinese)
              .fontSize(36)
              .fontWeight(FontWeight.Bold)
              .margin({ bottom: 20 })
              .textAlign(TextAlign.Center)

            if (this.showAnswer) {
              Text(this.currentMode === ReciteMode.EN_TO_CN
                ? this.filteredWordList[this.currentIndex].chinese
                : this.filteredWordList[this.currentIndex].english)
                .fontSize(22)
                .fontColor(Color.Grey)
                .textAlign(TextAlign.Center)
            }
          }
          .width('100%')
          .padding(40)
        }
        .width('90%')
        .backgroundColor(Color.White)
        .borderRadius(16)
        .shadow({ radius: 12, color: '#CCCCCC', offsetX: 0, offsetY: 4 })
        .margin({ bottom: 30 })
      } else {
        // æ— æ•°æ®æç¤º
        Text(this.isWrongBook ? "æš‚æ— æ ‡è®°é”™è¯" : "æ— åŒ¹é…å•è¯")
          .fontSize(20)
          .fontColor(Color.Grey)
          .margin({ bottom: 30 })
      }

      // åŠŸèƒ½æŒ‰é’®åŒº
      Row({ space: 20 }) {
        Button("æŸ¥çœ‹ç­”æ¡ˆ")
          .width(110)
          .height(45)
          .backgroundColor('#2196F3')
          .fontColor(Color.White)
          .borderRadius(8)
          .onClick(() => this.showAnswer = true)
          .enabled(this.filteredWordList.length > 0)

        Button(this.filteredWordList.length > 0 && this.filteredWordList[this.currentIndex].isWrong
          ? "å–æ¶ˆé”™è¯" : "æ ‡è®°é”™è¯")
          .width(110)
          .height(45)
          .backgroundColor(this.filteredWordList.length > 0 && this.filteredWordList[this.currentIndex].isWrong
            ? '#FF9800' : '#F44336')
          .fontColor(Color.White)
          .borderRadius(8)
          .onClick(() => this.toggleWrongWord())
          .enabled(this.filteredWordList.length > 0)

        Button("ä¸‹ä¸€ä¸ªå•è¯")
          .width(110)
          .height(45)
          .backgroundColor('#4CAF50')
          .fontColor(Color.White)
          .borderRadius(8)
          .onClick(() => this.nextWord())
          .enabled(this.filteredWordList.length > 0)
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F5F7FA')
    .justifyContent(FlexAlign.Center)
  }
