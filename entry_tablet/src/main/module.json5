{
  "module": {
    "name": "entry_tablet",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "Entry_tabletAbility",
    "deviceTypes": [
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "Entry_tabletAbility",
        "srcEntry": "./ets/entry_tabletability/Entry_tabletAbility.ets",
        "description": "$string:Entry_tabletAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:Entry_tabletAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "Entry_tabletBackupAbility",
        "srcEntry": "./ets/entry_tabletbackupability/Entry_tabletBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      }
    ]
  }
}